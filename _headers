# _headers — ATURAN CACHE UNTUK HOSTING (Cloudflare Pages / Netlify / serupa)
# Upload ke FOLDER ROOT hosting (berdampingan dgn index.html).
# Tujuan (pembenahan #4): setelah rotasi akit, browser pengguna langsung
# mendapat index.html BARU — tanpa layar hitam & tanpa hapus data browser.
/index.html
  Cache-Control: no-cache, must-revalidate
/*.html
  Cache-Control: no-cache, must-revalidate
/avg.js
  Cache-Control: no-store
/assets/js/avg.js
  Cache-Control: no-store
/media.js
  Cache-Control: public, max-age=31536000, immutable
