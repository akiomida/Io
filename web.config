<?xml version="1.0" encoding="UTF-8"?>
<!-- web.config — ATURAN CACHE UNTUK HOSTING IIS (Windows).
     Upload ke FOLDER ROOT hosting. Tujuan: pembenahan #4 (index.html selalu segar). -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <remove name="Cache-Control" />
        <add name="Cache-Control" value="no-cache, must-revalidate" />
      </customHeaders>
    </httpProtocol>
    <rewrite>
      <outboundRules rewriteBeforeCache="true">
        <rule name="avg-no-store">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="avg\.js" />
          </conditions>
          <action type="Rewrite" value="no-store" />
        </rule>
        <rule name="media-immutable">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="media\.js" />
          </conditions>
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
